# Copy to .env and fill in. Never commit .env.

# Long random string used to sign login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CELLIQ_JWT_SECRET=

# Gemini report drafting (optional: without a key a fixed template report is used)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Real email through Gmail (optional). Without these, emails are saved to data/outbox, not sent.
# Use a Google App Password (needs 2-step verification), never your normal password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Origins of the website allowed to call this API (comma separated)
CELLIQ_CORS=http://localhost:3000,http://localhost:5173

# Triage thresholds (placeholders until chosen on validation data)
CELLIQ_THRESHOLD_HIGH=0.70
CELLIQ_THRESHOLD_REVIEW=0.40

# Optional overrides
# CELLIQ_DB=sqlite:///data/celliq.db
# CELLIQ_UPLOADS=data/uploads
# CELLIQ_MAX_UPLOAD_MB=20
# CELLIQ_JWT_HOURS=8
